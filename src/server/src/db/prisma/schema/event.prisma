model Event {
  id          String    @id @default(cuid())
  eventTypeId String
  teamId      String
  iteration   Int // EJF 13, BEC 6, etc.
  year        Int
  startDate   DateTime?
  endDate     DateTime?
  description String?

  eventType EventType @relation(fields: [eventTypeId], references: [id])
  team      Team      @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventTypeId, iteration, year])
  @@map("events")
}

model EventType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  // Relations
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("event_types")
}
