model MemberPosition {
  id       String @id @default(cuid())
  memberId String
  roleId   String

  // A position either belongs to a team (and takes its period from it) ...
  teamId String?

  // ... or stands alone (e.g. a role in an external project) and keeps its own
  // organisation and years.
  organization String?
  startYear    Int?
  endYear      Int?

  member Member @relation(fields: [memberId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])
  team   Team?  @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([teamId])
  @@map("member_positions")
}
