model Member {
  id                 String       @id @default(cuid())
  name               String
  birthday           DateTime
  email              String?      @unique
  phoneNumber        String?      @unique
  telegramLink       String?      @unique
  instagramLink      String?      @unique
  facebookLink       String?      @unique
  linkedinLink       String?      @unique
  familyGroup        FamilyGroup? @relation("FamilyGroupMembers", fields: [familyGroupId], references: [id])
  familyGroupId      String?
  foundedFamilyGroup FamilyGroup?
  status             Status       @default(OBSERVER)
  joinedAt           DateTime?
  photo              String?
  mentor             Member?      @relation("MentorMentees", fields: [mentorId], references: [id])
  mentees            Member[]     @relation("MentorMentees")
  mentorId           String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

enum Status {
  OBSERVER
  BABY
  FULL
  ALUMNI
}
