model Member {
  id            String        @id @default(cuid())
  name          String
  joinedAt      DateTime
  status        Status        @default(OBSERVER)
  activityState ActivityState @default(ACTIVE)

  mentorId      String?
  familyGroupId String?
  email         String?
  birthday      DateTime?
  course        Int?
  photo         String?
  telegramLink  String?
  instagramLink String?
  facebookLink  String?
  linkedinLink  String?

  foundedFamilyGroup FamilyGroup?
  familyGroup        FamilyGroup?     @relation("FamilyGroupMembers", fields: [familyGroupId], references: [id])
  mentor             Member?          @relation("MentorMentees", fields: [mentorId], references: [id])
  mentees            Member[]         @relation("MentorMentees")
  positions          MemberPosition[]
  phoneNumbers       PhoneNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, status, joinedAt])
  @@map("members")
}

enum ActivityState {
  ACTIVE
  INACTIVE
  EXCLUDED
}

enum Status {
  OBSERVER
  BABY
  FULL
  ALUMNI
}
