model Member {
  id            String        @id @default(cuid())
  name          String
  joinedAt      DateTime
  status        Status        @default(OBSERVER)
  activityState ActivityState @default(ACTIVE)

  mentorId      String?
  familyGroupId String?
  email         String?
  birthday      DateTime?
  course        Int?
  photo         String?
  telegramLink  String?
  instagramLink String?
  facebookLink  String?
  linkedinLink  String?
  gender        Gender?

  foundedFamilyGroup FamilyGroup?
  familyGroup        FamilyGroup?     @relation("FamilyGroupMembers", fields: [familyGroupId], references: [id])
  mentor             Member?          @relation("MentorMentees", fields: [mentorId], references: [id])
  mentees            Member[]         @relation("MentorMentees")
  positions          MemberPosition[]
  suggestions        EditSuggestion[]

  // Display choices the member makes about themselves.
  featuredPositionId String?         @unique
  featuredPosition   MemberPosition? @relation("FeaturedPosition", fields: [featuredPositionId], references: [id], onDelete: SetNull)
  nameBadgeTeamId    String?
  nameBadgeTeam      Team?           @relation("NameBadgeTeam", fields: [nameBadgeTeamId], references: [id], onDelete: SetNull)
  phoneNumbers       PhoneNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, status, joinedAt])
  @@index([mentorId])
  @@map("members")
}

enum ActivityState {
  ACTIVE
  INACTIVE
  EXCLUDED
}

enum Status {
  OBSERVER
  BABY
  FULL
  ALUMNI
}

enum Gender {
  MALE
  FEMALE
}
