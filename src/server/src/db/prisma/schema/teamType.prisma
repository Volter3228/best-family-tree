model TeamType {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  color       String?
  iconUrl     String?
  // Events (BTW, BEST::HACKathOn) have yearly editions; teams without a name
  // are called "<type> <start year>". Other types (working groups) are a single
  // lasting team named after the type.
  isEvent     Boolean @default(true)

  // Relations
  teams Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_types")
}
