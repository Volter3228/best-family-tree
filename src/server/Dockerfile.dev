FROM node:22.15.1-alpine

WORKDIR /app

# Install dependencies first (better layer caching)
COPY . .
RUN npm install

ENV DATABASE_URL="postgresql://postgres:postgres@postgres:5432/best_family_tree?schema=public"

# Generate Prisma client (schema is now in a directory)
RUN npx prisma generate

# Expose Express server port
EXPOSE 3001

# Start with nodemon for hot-reload (uses npm run serve)
CMD ["npm", "run", "serve"]

