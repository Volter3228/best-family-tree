FROM node:20-slim

WORKDIR /app

# Install OpenSSL (required by Prisma)
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# Install dependencies first (better layer caching)
COPY package*.json ./
RUN npm install

# Copy Prisma schema for client generation
COPY src/db/prisma ./src/db/prisma

# Generate Prisma client (schema is now in a directory)
RUN npx prisma generate --schema=./src/db/prisma/schema

# Copy source files (these will be overwritten by volume mounts in dev)
COPY . .

# Expose Express server port
EXPOSE 3001

# Start with nodemon for hot-reload (uses npm run serve)
CMD ["npm", "run", "serve"]

