# Frontend / deployment environment variables.
# Copy this file to .env and fill in your values.
#
# "build" = fixed when `next build` / `docker build` runs (change => rebuild).
# "runtime" = read when the process starts (change => restart only).

# [build + runtime] Server-side URL of the Express API. In the production
# image Express lives in the same container, so this is
# http://127.0.0.1:3001/api (a Docker build arg, default already correct).
# In docker-compose dev it is http://backend:3001/api.
API_URL_INTERNAL=

# [build, dev fallback] API URL used when API_URL_INTERNAL is not set.
# The browser itself always calls same-origin /api.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# [runtime] true = demo mode: no sign-in, writes refused (read by proxy.ts).
# DEMO_MODE=true

# [runtime, production container] Port Next listens on; hosts set it for you.
# PORT=3000
#
# Express-side variables (database, auth secret, Cloudinary, CLIENT_ORIGIN,
# HOST, TRUST_PROXY_HOPS, COOKIE_SECURE) live in src/server/.env.example.
